      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"light_readings\")\n  |> range(start: -10s, stop: now())\n  |> filter(fn: (r) => r._measurement == \"light\" and r._field == \"raw\" and r.device == \"freenove-v4.1\")\n  |> last()",
          "datasource": {
            "type": "influxdb",
            "uid": "freenove-influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ADC",
          "decimals": 0,
          "noValue": "NO DATA",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "min": 0,
          "max": 1023
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
