  "panels": [
    {
      "id": 2,
      "title": "Current light reading",
      "type": "stat",
      "description": "Latest physical USB sample within the last 10 seconds. Raw ADC counts, not calibrated lux.",
      "gridPos": {
        "x": 0,
        "y": 0,
